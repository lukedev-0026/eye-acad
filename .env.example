# Copy to .env.local and fill in. .env.local is ignored by git.
#
# Every setting is optional: a fresh copy with no env file runs against the
# local emulators and a local Ollama, by typing, with no key at all. The full
# list, with what each becomes, is in src/config/env.schema.ts.

# Speech-to-text and text-to-speech. The only key the app needs.
# Without it the app still works by typing; replies are shown but not spoken.
DEEPGRAM_API_KEY=

# Where the local language models are served. This is Ollama's default.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_KEEP_ALIVE=30m
# VIVA_EMBEDDING_MODEL=nomic-embed-text

# Speech models, and how a reply is turned into audio ("per-sentence" or "single").
# VIVA_STT_MODEL=nova-3-medical
# VIVA_TTS_VOICE=aura-2-draco-en
# VIVA_SPEECH_MODE=per-sentence

# Logging. Unset: level "info", human-readable lines (JSON in production).
# LOG_LEVEL=info
# LOG_FORMAT=pretty

# Firebase. A project id starting "demo-" never talks to Google: the app uses
# the local emulators.
# VITE_FIREBASE_PROJECT_ID=demo-viva

# Files, relative to the project folder unless absolute.
# VIVA_CASE_FILE=data/case-EA-VIVA-001.json
# VIVA_STEPS_FILE=config/steps.json
# VIVA_NOTE_PDF=data/reference-note.pdf
# VIVA_NOTE_INDEX=data/note-index.json

# Only needed if a step in config/steps.json is switched to provider "anthropic".
# ANTHROPIC_API_KEY=
