{
  "name": "eye-academy-viva",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "emulators": "firebase emulators:start --project demo-viva --only auth,firestore",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:integration:ci": "firebase emulators:exec --project demo-viva --only auth,firestore \"vitest run --project integration\"",
    "golden": "tsx scripts/golden.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm golden && pnpm build",
    "findings": "tsx scripts/findings.ts",
    "ingest": "tsx scripts/ingest.ts",
    "retrieval-table": "tsx scripts/retrieval-table.ts",
    "check": "tsx scripts/check.ts",
    "readback": "tsx scripts/readback.ts",
    "sweep:preflight": "tsx scripts/sweep-preflight.ts",
    "sweep": "tsx scripts/sweep.ts",
    "sweep:report": "tsx scripts/sweep-report.ts",
    "sweep:chart": "tsx scripts/sweep-chart.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "firebase": "12.19.0",
    "firebase-admin": "~14.5.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "~15.37.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.0.0",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "packageManager": "pnpm@10.13.1"
}
